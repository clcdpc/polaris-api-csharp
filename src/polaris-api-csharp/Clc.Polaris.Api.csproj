<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<RootNamespace>Clc.Polaris.Api</RootNamespace>
		<PackageId>Clc.Polaris.Api</PackageId>
		<Authors>Central Library Consortium, Michael Fields</Authors>
		<Description>A helper library that assists in the consumption of the Polaris ILS API</Description>
		<PackageTags>clc; polaris; papi; polarisapi</PackageTags>
		<PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
		<Title>Polaris Api Library Helper Library</Title>
		<PackageProjectUrl>https://github.com/clcdpc/polaris-api-csharp</PackageProjectUrl>
		<RepositoryUrl>https://github.com/clcdpc/polaris-api-csharp</RepositoryUrl>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReleaseNotes>Use RestClient 3.0.0-beta.3; strengthen operation validation and organization routing; expand typed PAPI endpoint coverage; correct hold create/reply response GUID, status, qualifier, and queue fields, including the documented misspelled response qualifier field and empty XML GUIDs; expose native primary material type and documented BIB sort/transaction options.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Clc.Rest.Client" Version="3.0.0-beta.3" />
	</ItemGroup>

</Project>
